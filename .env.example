# iTraCS MATSim & SUMO Simulation Backend Environment Configuration
# Copy this file to .env and configure local values

# HTTP Server Configuration
PORT=5005
HOST=127.0.0.1
DEBUG=False

# Allowed CORS Origins (comma-separated, no trailing slash, avoid wildcard * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SUMO Environment (Optional if using standalone MATSim engine)
# SUMO_HOME=/usr/local/opt/sumo/share/sumo

# Python Environment
PYTHONUNBUFFERED=1
