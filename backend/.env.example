# Backend Configuration Template
# Copy to .env and configure your environment variables
# DO NOT commit real secrets or production credentials to source control

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# MongoDB Connection
# Set to 'mongodb://localhost:27017' for local MongoDB or Atlas URI 'mongodb+srv://<user>:<password>@cluster.mongodb.net'
# Leave empty or set USE_MOCK_DB=true to use zero-config in-memory mock database
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=fraud_detection_db
USE_MOCK_DB=false

# Stream Simulator Defaults
STREAM_SPEED=10
DEFAULT_DATASET_PATH=backend/data/paysim_sample.csv

# Algorithm Settings
BLOOM_EXPECTED_ACCOUNTS=100000
BLOOM_FALSE_POSITIVE_RATE=0.01
DGIM_WINDOW_SIZE=10000
DGIM_HIGH_VALUE_THRESHOLD=200000.0
FM_HASH_COUNT=32

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
