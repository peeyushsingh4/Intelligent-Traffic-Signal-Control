<configuration>
    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="../routes/emergency_scenario.rou.xml"/>
        <additional-files value="../additional/detectors.add.xml"/>
    </input>
    <output>
        <emission-output value="../output/emissions/emergency_scenario_emissions.xml"/>
        <tripinfo-output value="../output/tripinfo/emergency_scenario_tripinfo.xml"/>
        <statistic-output value="../output/statistics/emergency_scenario_statistics.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.5"/>
    </time>
    <processing>
        <lateral-resolution value="0.8"/>
    </processing>
</configuration>
