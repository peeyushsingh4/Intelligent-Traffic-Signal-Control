<routes>
    <!-- Vehicle Types -->
    <vType id="car" vClass="passenger" maxSpeed="13.89" emissionClass="HBEFA3/PC_G_EU4"/>
    <vType id="bus" vClass="bus" maxSpeed="11.11" emissionClass="HBEFA3/Bus"/>
    <vType id="ambulance" vClass="emergency" guiShape="emergency" maxSpeed="38.89" has.bluelight.device="true"/>
    <vType id="firetruck" vClass="emergency" guiShape="firebrigade" maxSpeed="33.33" has.bluelight.device="true"/>
    <vType id="police" vClass="emergency" guiShape="police" maxSpeed="41.67" has.bluelight.device="true"/>

    <!-- Routes -->
    <route id="r_WE" edges="A0B0 B0C0"/>
    <route id="r_EW" edges="C0B0 B0A0"/>
    <route id="r_NS" edges="B1B0 B0B-1"/>
    <route id="r_SN" edges="B-1B0 B0B1"/>

    <!-- Flows (Rush Hour Unequal) -->
    <!-- N->S=400 (380 car, 20 bus) -->
    <flow id="f_NS_car" type="car" route="r_NS" begin="0" end="3600" vehsPerHour="380"/>
    <flow id="f_NS_bus" type="bus" route="r_NS" begin="0" end="3600" vehsPerHour="20"/>

    <!-- S->N=80 (76 car, 4 bus) -->
    <flow id="f_SN_car" type="car" route="r_SN" begin="0" end="3600" vehsPerHour="76"/>
    <flow id="f_SN_bus" type="bus" route="r_SN" begin="0" end="3600" vehsPerHour="4"/>

    <!-- E->W=350 (333 car, 17 bus) -->
    <flow id="f_EW_car" type="car" route="r_EW" begin="0" end="3600" vehsPerHour="333"/>
    <flow id="f_EW_bus" type="bus" route="r_EW" begin="0" end="3600" vehsPerHour="17"/>

    <!-- W->E=70 (66 car, 4 bus) -->
    <flow id="f_WE_car" type="car" route="r_WE" begin="0" end="3600" vehsPerHour="66"/>
    <flow id="f_WE_bus" type="bus" route="r_WE" begin="0" end="3600" vehsPerHour="4"/>
</routes>
